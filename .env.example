# ==============================================================================
# A2A Gateway — Environment Variables Template
# Copy this file to .env and customize for your deployment:
#   cp .env.example .env
# ==============================================================================

# Database & Cache URLs
DATABASE_URL=postgresql+asyncpg://a2a:a2a@postgres:5432/a2a
REDIS_URL=redis://redis:6379/0

# Authentication & Security
# Change ADMIN_KEY before binding to any non-loopback network interface!
ADMIN_KEY=dev-only-do-not-use-in-prod
ALLOW_INSECURE_DEV_KEY=false
SECRET_KEY=a2a-gateway-default-secret-key-change-me

# Optional dedicated 32-byte url-safe base64 Fernet key for credential encryption:
# CREDENTIAL_ENCRYPTION_KEY=

# Streaming & Durability Tunables
EVENT_QUEUE_MAXSIZE=10000
SYNC_PERSIST_GATEWAY_NOTES=true
DRAIN_TIMEOUT_S=5.0
UPSTREAM_CONNECT_TIMEOUT_S=5.0
UPSTREAM_IDLE_TIMEOUT_S=120.0
CARD_CACHE_TTL_S=5.0

# Logging
LOG_LEVEL=info

